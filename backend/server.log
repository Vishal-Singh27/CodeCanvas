    "tool_call_id": "fc_58c85d38-a24c-4195-976a-6eef327e27ef",
    "content": "import React, { useState, useEffect, useContext } from 'react';\nimport { useParams, Link } from 'react-router-dom';\nimport { AuthContext } from './Context';\nimport { Post } from \"./Post\";\nimport axios from 'axios';\nimport { motion } from 'framer-motion';\nimport userAvatar from '/images/user.png';\n\nconst API_BASE =\n  process.env.NODE_ENV === \"production\"\n    ? \"https://wanderback.vercel.app\"\n    : \"http://localhost:5002\";\n\nexport const Profile = () => {\n  const { user, isLoggedIn } = useContext(AuthContext);\n  const { username: profileUsername } = useParams();\n  const targetUser = profileUsername || user?.username;\n\n  const [posts, setPosts] = useState([]);\n  const [loaded, setLoaded] = useState(false);\n  const [following, setFollowing] = useState(false);\n  const [profilePic, setProfilePic] = useState(userAvatar);\n\n  useEffect(() => {\n    if (!isLoggedIn || !targetUser) return;\n\n    const load_data = async () => {\n      try {\n        // Fetch posts by username\n        const response = await axios.get(`${API_BASE}/posts/${targetUser}`);\n\n        // Fetch profile picture by username\n        const userRes = await axios.get(`${API_BASE}/user/${targetUser}`);\n        setProfilePic(userRes.data.profilePicture || userAvatar);\n\n        // Fetch followers\n        const follower_res = await axios.get(`${API_BASE}/user/followers/${targetUser}`);\n        const followers = follower_res.data.Followers || [];\n        setFollowing(followers.includes(user?.username));\n\n        // Handle posts\n        const postsData = Array.isArray(response.data)\n          ? response.data\n          : response.data.posts || [];\n        setPosts(postsData);\n\n      } catch (error) {\n        console.error(\"Failed to fetch profile data:\", error);\n        setPosts([]);\n      } finally {\n        setLoaded(true);\n      }\n    };\n\n    load_data();\n  }, [isLoggedIn, targetUser]); // no `following` here to avoid loops\n\n  if (!isLoggedIn) {\n    return (\n      <div className='text-center h-screen flex items-center justify-center bg-gray-900 text-white'>\n        <p>\n          Please <Link to=\"/login\" className=\"text-cyan-400 hover:underline\">login</Link> to view profiles.\n        </p>\n      </div>\n    );\n  }\n\n  if (!loaded) {\n    return (\n      <div className='h-screen flex items-center justify-center text-xl font-semibold text-gray-300 animate-pulse bg-gray-900'>\n        Loading Profile...\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-900 text-white\">\n      {/* Profile Header */}\n      <header className=\"bg-gray-800/50 p-8 shadow-lg\">\n        <div className=\"max-w-5xl mx-auto flex flex-col sm:flex-row items-center gap-8\">\n          <motion.div\n            className=\"w-32 h-32 rounded-full overflow-hidden border-4 border-cyan-400\"\n            initial={{ scale: 0.5, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            transition={{ duration: 0.5 }}\n          >\n            <img src={profilePic} alt=\"User Avatar\" className=\"w-full h-full object-cover\" />\n          </motion.div>\n\n          <motion.div\n            initial={{ x: -20, opacity: 0 }}\n            animate={{ x: 0, opacity: 1 }}\n            transition={{ duration: 0.5, delay: 0.2 }}\n          >\n            <h1 className=\"text-4xl font-bold\">\n              {targetUser}\n              {targetUser !== user?.username && (\n                <button\n                  onClick={async () => {\n                    if (following) {\n                      await axios.post(`${API_BASE}/user/${targetUser}/unfollow`, { username: user?.username });\n                      setFollowing(false);\n                    } else {\n                      await axios.post(`${API_BASE}/user/${targetUser}/follow`, { username: user?.username });\n                      setFollowing(true);\n                    }\n                  }}\n                  className='ml-10 text-2xl text-white bg-red-500 px-5 py-1 border-2 rounded-lg'\n                >\n                  {following ? `Unfollow` : `Follow`}\n                </button>\n              )}\n            </h1>\n            <p className=\"text-white/70 mt-2\">\n              {targetUser === user?.username ? \"Your profile\" : `Viewing @${targetUser}`} • {posts.length} {posts.length === 1 ? 'post' : 'posts'}\n            </p>\n          </motion.div>\n        </div>\n      </header>\n\n      {/* User's Posts */}\n      <main className=\"max-w-5xl mx-auto p-8\">\n        <h2 className=\"text-3xl font-bold mb-8\">\n          {targetUser === user?.username ? \"Your Posts\" : `${targetUser}'s Posts`}\n        </h2>\n\n        {posts.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n            {posts.map((post, index) => (\n              <motion.div\n                key={post._id || index}\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.5, delay: index * 0.1 }}\n              >\n                <div className=\"rounded-2xl h-full overflow-hidden shadow-lg bg-black/20 backdrop-blur-lg border border-white/10 text-white hover:shadow-cyan-500/20 transition-shadow duration-300\">\n                  <Post data={post} />\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"text-center py-16 bg-gray-800/50 rounded-lg\">\n            <p className=\"text-xl text-white/70\">\n              {targetUser === user?.username\n                ? \"You haven't posted anything yet.\"\n                : `${targetUser} hasn't posted anything yet.`}\n            </p>\n            {targetUser === user?.username && (\n              <Link to=\"/add_post\" className=\"mt-4 inline-block bg-cyan-500 hover:bg-cyan-400 text-black font-bold py-2 px-6 rounded-lg transition-colors\">\n                Create Your First Post\n              </Link>\n            )}\n          </div>\n        )}\n      </main>\n    </div>\n  );\n};"
  }
]
